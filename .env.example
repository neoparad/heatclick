# UGOKI MAP / LINKTH SaaS — Environment Variables Template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Production secrets must be configured in Vercel dashboard.
# 親 SSOT §3.7.2 Secrets 管理ルール参照。

# =============================================================================
# Application
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="UGOKI MAP"
NODE_ENV=development

# =============================================================================
# Authentication (JWT)
# =============================================================================
JWT_SECRET=<generate-32-byte-random-string>
NEXTAUTH_SECRET=<generate-32-byte-random-string>
JWT_EXPIRES_IN=4h

# -----------------------------------------------------------------------------
# Owner / dogfood 専用・メール不要ログイン (続 119, 親 SSOT §3.6.1)
# -----------------------------------------------------------------------------
# 検証ループで magic-link が使いにくい問題への対処。email + この合言葉で、
# 今見ている host にそのまま session Cookie を発行する owner 専用ログイン口。
#
# セキュリティ (これ自体が新たな認証面 = T1):
#   - 未設定なら機能ごと無効。/auth/dev-login は 404、/api/auth/dev-login も 404。
#     → 本番で入れない限り攻撃面ゼロ。検証が済んだら env を消せば即無効化できる。
#   - 24 文字未満は弱すぎるとして無効扱い (fail-closed)。
#   - 必ず強い乱数で生成すること。人間が覚えられる合言葉は使わない:
#       openssl rand -hex 32
#   - secret は git/コード/URL に絶対に載せない。Vercel env (Production) にのみ投入。
#   - 認可は「secret 一致 (constant-time)」AND「email が dogfood allowlist 内」。
# OWNER_LOGIN_SECRET=<generate-via: openssl rand -hex 32 — leave UNSET to disable>

# =============================================================================
# Database — Hetzner ClickHouse (本番) / ローカル via SSH tunnel
# =============================================================================
CLICKHOUSE_URL=http://default:PASSWORD@localhost:8123/clickinsight
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=clickinsight
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=<set-in-vercel>

# ClickHouse 3-role 分離 (Infra 続 67 D-3 配備済前提、続 70 fail-fast 強化)
# production (NODE_ENV=production) では analytics_reader / chat_writer の専用 password 必須。
# 未投入時は `lib/clickhouse.ts:requireRoleCredentialOrThrow()` が throw
# → /api/chat が ORCHESTRATOR_FAILED (502) で degrade
# 続 74 Task F (Owner 2026-05-24 09:34 JST AI チャット失敗) 直接原因 = この 2 env 未投入。
CLICKHOUSE_RO_USERNAME=analytics_reader
CLICKHOUSE_RO_PASSWORD=<set-in-vercel>
CLICKHOUSE_WRITER_USERNAME=chat_writer
CLICKHOUSE_WRITER_PASSWORD=<set-in-vercel>

# =============================================================================
# Database — Hetzner PostgreSQL (linkscrawl 構造データ + pgvector)
# =============================================================================
DATABASE_URL=postgresql://linkscrawl:PASSWORD@localhost:5433/linkscrawl

# =============================================================================
# Cache + Queue — Redis
# =============================================================================
REDIS_URL=redis://localhost:6380/0

# =============================================================================
# LLM Providers
# =============================================================================
ANTHROPIC_API_KEY=<set-in-vercel>
GOOGLE_API_KEY=<set-in-vercel>
GOOGLE_AI_STUDIO_PROJECT_ID=<optional>
OLLAMA_BASE_URL=http://localhost:11434

# Routing (parent SSOT §2.2.6 / §3.5.2)
LLM_DEFAULT_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=ollama

# AIチャット (/api/chat、続 54 §3.1 B / 続 57 Sprint 3 W1 / 続 60 §2 / 続 64 hardening):
# - stub            (dev/test 既定、stub reply。LLM call 発火しない。production 起動不可)
# - anthropic-direct (legacy 隔離、ANTHROPIC_API_KEY 必須。production 起動不可)
# - ai-gateway       (canonical、Vercel AI Gateway 経由、AI_GATEWAY_API_KEY 必須。production 唯一許可)
# Owner 判断 (続 60 §2): LLM_PROVIDER_MODE=ai-gateway 確定。production 起動時 fail-fast (続 64)。
LLM_PROVIDER_MODE=stub

# Vercel AI Gateway 標準 env 名 (続 61 §3 (d) で `AI_GATEWAY_KEY` から rename 統一)
AI_GATEWAY_API_KEY=<set-in-vercel-if-ai-gateway-mode>

# Gateway 既定 model id (任意、未設定時は lib/llm/gateway.ts の DEFAULT_GATEWAY_MODEL)
# 例: anthropic/claude-sonnet-4-5-20250929 / google/gemini-2.5-flash
# AI_GATEWAY_DEFAULT_MODEL=anthropic/claude-sonnet-4-5-20250929

# =============================================================================
# SEO / SERP / AIO
# =============================================================================
DATAFORSEO_LOGIN=<set-in-vercel>
DATAFORSEO_PASSWORD=<set-in-vercel>
GOOGLE_PAGESPEED_API_KEY=<set-in-vercel>

# Google Search Console + GA4
GOOGLE_APPLICATION_CREDENTIALS=<path-to-service-account-json>
GOOGLE_SHEETS_API_KEY=<optional>

# =============================================================================
# Billing — Stripe (Sprint 1-2 末に審査申請、W2-01)
# =============================================================================
STRIPE_SECRET_KEY=<set-in-vercel>
STRIPE_WEBHOOK_SECRET=<set-in-vercel>
STRIPE_PRICE_ID_STARTER=<set-after-product-creation>
STRIPE_PRICE_ID_GROWTH=<set-after-product-creation>
STRIPE_PRICE_ID_AGENCY=<set-after-product-creation>

# =============================================================================
# Email — Resend (ドメイン: ugokimap.com、既存)
# =============================================================================
RESEND_API_KEY=<set-in-vercel>
EMAIL_FROM=noreply@ugokimap.com
EMAIL_SUPPORT=support@ugokimap.com

# =============================================================================
# Monitoring — Sentry + Inngest
# =============================================================================
SENTRY_DSN=<set-in-vercel>
SENTRY_AUTH_TOKEN=<for-source-maps>
INNGEST_EVENT_KEY=<set-in-vercel>
INNGEST_SIGNING_KEY=<set-in-vercel>

# =============================================================================
# Cloudflare Workers (event-ingest endpoint)
# =============================================================================
NEXT_PUBLIC_TRACKING_ENDPOINT=https://ugokimap-event-ingest.linkth.workers.dev/api/track
NEXT_PUBLIC_TRACKING_SCRIPT_URL=https://ugokimap.com/v2/tracking.js

# =============================================================================
# Cloudflare R2 (banner assets + heatmap screenshot 永続 cache)
# =============================================================================
# banner-assets bucket を流用 (lib/scenarios/r2-signed-url.ts)。
# heatmap screenshot cache (lib/heatmap/r2-screenshot-cache.ts) も同じ token/bucket を使う。
#   - bucket は **public access 不可** (tenant data)。serve は短命 signed GET URL のみ。
#   - 未設定なら heatmap screenshot は L1 (in-memory) のみで degrade (従来動作)。
# R2_ACCOUNT_ID=<cloudflare account id>
# R2_ACCESS_KEY_ID=<R2 API token access key id>
# R2_SECRET_ACCESS_KEY=<R2 API token secret>
# R2_BUCKET=banner-assets

# Cloudflare Browser Rendering (heatmap screenshot の PRIMARY provider)
#   - REST API で full-page screenshot を binary で取得 (lib/heatmap/screenshot-provider.ts)。
#   - token は "Browser Rendering - Edit" 権限を持つ Cloudflare API token。
#   - CLOUDFLARE_ACCOUNT_ID 未設定時は R2_ACCOUNT_ID を流用する (同一 Cloudflare account)。
#   - **両方 (token + account id) 揃った時のみ** Cloudflare を使う。未設定なら下の Microlink に fallback。
# CLOUDFLARE_API_TOKEN=<Browser Rendering edit token>
# CLOUDFLARE_ACCOUNT_ID=<cloudflare account id, 省略時 R2_ACCOUNT_ID を使用>

# Screenshot Worker — Puppeteer + autoScroll (PRIMARY provider, fix/login-bounce-whitescreen-117)
#   - Workers Puppeteer で full-page を autoScroll して lazy-load 画像を確実に撮影する。
#   - CF Browser Rendering REST より信頼性が高い (addScriptTag 後の wait 制限がない)。
#   - 両方 set 時のみ有効。未設定なら下の CF Browser Rendering にフォールバック。
#   - SCREENSHOT_WORKER_URL: `wrangler deploy` 後に表示される Workers URL
#     例: https://ugokimap-screenshot.<account>.workers.dev
#   - SCREENSHOT_WORKER_TOKEN: wrangler secret put SCREENSHOT_WORKER_TOKEN で Worker に投入した値と同一
#     生成例: openssl rand -hex 32
# SCREENSHOT_WORKER_URL=<https://ugokimap-screenshot.<account>.workers.dev>
# SCREENSHOT_WORKER_TOKEN=<same-secret-as-wrangler-secret>

# Microlink screenshot API (fallback、Cloudflare 未設定時のみ使用)
#   - free tier OK だが full-page の下部が切れることがある (Cloudflare 移行の動機)。
# MICROLINK_API_KEY=<optional>

# =============================================================================
# Feature Flags (Phase 1)
# =============================================================================
FEATURE_AISEO_ENABLED=false      # Sprint 4 で true
FEATURE_AGENCY_ENABLED=false     # Sprint 5 で true
FEATURE_MCP_PUBLIC=false         # Phase 2 で true
FEATURE_DECISION_PLANE=false     # Phase 3 で true (§3.9)

# =============================================================================
# Development only
# =============================================================================
DEBUG=false
LOG_LEVEL=info
