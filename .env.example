# UGOKI MAP / LINKTH SaaS — Environment Variables Template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Production secrets must be configured in Vercel dashboard.
# 親 SSOT §3.7.2 Secrets 管理ルール参照。

# =============================================================================
# Application
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="UGOKI MAP"
NODE_ENV=development

# =============================================================================
# Authentication (JWT)
# =============================================================================
JWT_SECRET=<generate-32-byte-random-string>
NEXTAUTH_SECRET=<generate-32-byte-random-string>
JWT_EXPIRES_IN=4h

# -----------------------------------------------------------------------------
# Owner / dogfood 専用・メール不要ログイン (続 119, 親 SSOT §3.6.1)
# -----------------------------------------------------------------------------
# 検証ループで magic-link が使いにくい問題への対処。email + この合言葉で、
# 今見ている host にそのまま session Cookie を発行する owner 専用ログイン口。
#
# セキュリティ (これ自体が新たな認証面 = T1):
#   - 未設定なら機能ごと無効。/auth/dev-login は 404、/api/auth/dev-login も 404。
#     → 本番で入れない限り攻撃面ゼロ。検証が済んだら env を消せば即無効化できる。
#   - 24 文字未満は弱すぎるとして無効扱い (fail-closed)。
#   - 必ず強い乱数で生成すること。人間が覚えられる合言葉は使わない:
#       openssl rand -hex 32
#   - secret は git/コード/URL に絶対に載せない。Vercel env (Production) にのみ投入。
#   - 認可は「secret 一致 (constant-time)」AND「email が dogfood allowlist 内」。
# OWNER_LOGIN_SECRET=<generate-via: openssl rand -hex 32 — leave UNSET to disable>

# =============================================================================
# Database — Hetzner ClickHouse (本番) / ローカル via SSH tunnel
# =============================================================================
CLICKHOUSE_URL=http://default:PASSWORD@localhost:8123/clickinsight
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=clickinsight
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=<set-in-vercel>

# =============================================================================
# Database — Hetzner PostgreSQL (linkscrawl 構造データ + pgvector)
# =============================================================================
DATABASE_URL=postgresql://linkscrawl:PASSWORD@localhost:5433/linkscrawl

# =============================================================================
# Cache + Queue — Redis
# =============================================================================
REDIS_URL=redis://localhost:6380/0

# =============================================================================
# LLM Providers
# =============================================================================
ANTHROPIC_API_KEY=<set-in-vercel>
GOOGLE_API_KEY=<set-in-vercel>
GOOGLE_AI_STUDIO_PROJECT_ID=<optional>
OLLAMA_BASE_URL=http://localhost:11434

# Routing (parent SSOT §2.2.6 / §3.5.2)
LLM_DEFAULT_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=ollama

# =============================================================================
# SEO / SERP / AIO
# =============================================================================
DATAFORSEO_LOGIN=<set-in-vercel>
DATAFORSEO_PASSWORD=<set-in-vercel>
GOOGLE_PAGESPEED_API_KEY=<set-in-vercel>

# Google Search Console + GA4
GOOGLE_APPLICATION_CREDENTIALS=<path-to-service-account-json>
GOOGLE_SHEETS_API_KEY=<optional>

# =============================================================================
# Billing — Stripe (Sprint 1-2 末に審査申請、W2-01)
# =============================================================================
STRIPE_SECRET_KEY=<set-in-vercel>
STRIPE_WEBHOOK_SECRET=<set-in-vercel>
STRIPE_PRICE_ID_STARTER=<set-after-product-creation>
STRIPE_PRICE_ID_GROWTH=<set-after-product-creation>
STRIPE_PRICE_ID_AGENCY=<set-after-product-creation>

# =============================================================================
# Email — Resend (ドメイン: ugokimap.com、既存)
# =============================================================================
RESEND_API_KEY=<set-in-vercel>
EMAIL_FROM=noreply@ugokimap.com
EMAIL_SUPPORT=support@ugokimap.com

# =============================================================================
# Monitoring — Sentry + Inngest
# =============================================================================
SENTRY_DSN=<set-in-vercel>
SENTRY_AUTH_TOKEN=<for-source-maps>
INNGEST_EVENT_KEY=<set-in-vercel>
INNGEST_SIGNING_KEY=<set-in-vercel>

# =============================================================================
# Cloudflare Workers (event-ingest endpoint)
# =============================================================================
NEXT_PUBLIC_TRACKING_ENDPOINT=https://ugokimap-event-ingest.linkth.workers.dev/api/track
NEXT_PUBLIC_TRACKING_SCRIPT_URL=https://ugokimap.com/v2/tracking.js

# =============================================================================
# Feature Flags (Phase 1)
# =============================================================================
FEATURE_AISEO_ENABLED=false      # Sprint 4 で true
FEATURE_AGENCY_ENABLED=false     # Sprint 5 で true
FEATURE_MCP_PUBLIC=false         # Phase 2 で true
FEATURE_DECISION_PLANE=false     # Phase 3 で true (§3.9)

# =============================================================================
# Development only
# =============================================================================
DEBUG=false
LOG_LEVEL=info
