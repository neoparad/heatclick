# ClickInsight Pro 環境変数

# アプリケーション設定
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# データベース設定
DATABASE_URL="postgresql://username:password@localhost:5432/clickinsight_pro"
CLICKHOUSE_URL="http://localhost:8123"
REDIS_URL="redis://localhost:6379"

# 認証設定
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=http://localhost:3000

# 外部API設定
CLAUDE_API_KEY=your-claude-api-key
# Google Search Console API
GSC_CLIENT_EMAIL=your-service-account-email@project-id.iam.gserviceaccount.com
GSC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour Private Key\n-----END PRIVATE KEY-----
GSC_SITE_URL=sc-domain:example.com
# または
# GSC_SITE_URL=https://example.com
GA4_API_KEY=your-ga4-api-key
GOOGLE_ADS_API_KEY=your-google-ads-api-key

# メール設定
RESEND_API_KEY=your-resend-api-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# 通知設定
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# ファイルストレージ設定
UPLOADTHING_SECRET=your-uploadthing-secret
UPLOADTHING_APP_ID=your-uploadthing-app-id

# 監視・ログ設定（Sentry）
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# 開発設定
DEBUG=true
LOG_LEVEL=info


# === UGOKI LINK v2 ===
# NOTE: プレースホルダのみ記載。実秘密値はローカルの .env.local / 本番 Secret Manager にのみ設定すること。

# --- ClickHouse 8 GiB 専用ノード (最小権限ロール分離: loader / builder / eraser / ro / admin) ---
UGK_CH_URL="https://clickhouse.ugokilink.example:8443"
UGK_CH_LOADER_USER="ugk_loader"
UGK_CH_LOADER_PASSWORD="<placeholder-ch-loader-password>"
UGK_CH_BUILDER_USER="ugk_builder"
UGK_CH_BUILDER_PASSWORD="<placeholder-ch-builder-password>"
UGK_CH_ERASER_USER="ugk_eraser"
UGK_CH_ERASER_PASSWORD="<placeholder-ch-eraser-password>"
UGK_CH_RO_PREFIX="ugk_ro_"
UGK_CH_ADMIN_USER="ugk_admin"
UGK_CH_ADMIN_PASSWORD="<placeholder-ch-admin-password>"

# --- Postgres 制御面 (アカウント・鍵・同意・承認・台帳・強整合制御) ---
UGK_PG_URL="postgresql://ugk_control:<placeholder-pg-password>@localhost:5432/ugokilink_control?sslmode=require"

# --- Cloudflare R2 (WAL / 隔離 / 再生 / 実験室スナップショット — 地域固定 D-29) ---
UGK_R2_REGION="jp"
UGK_R2_WAL_BUCKET="ugokilink-wal-jp"
UGK_R2_REPLAY_BUCKET="ugokilink-replay-jp"
UGK_R2_LAB_BUCKET="ugokilink-lab-jp"

# --- 鍵・署名・HMAC シークレット ---
# オフラインリリース署名検証用 Ed25519 公開鍵 (PEM / base64url)
UGK_OFFLINE_RELEASE_PUBKEY_ED25519="<placeholder-ed25519-release-public-key>"
# オンライン設定バンドル署名用 Ed25519 秘密鍵 (KMS 参照または PEM)
UGK_ONLINE_CONFIG_SIGNING_KEY="<placeholder-ed25519-config-signing-key>"
# API 秘密鍵 (ugk_sec_*) 保存用 HMAC ペッパー
UGK_SECRET_KEY_PEPPER="<placeholder-secret-key-pepper-256bit>"
# PV 継続トークン (pv_token) 署名シークレット
UGK_CONTINUITY_TOKEN_SECRET="<placeholder-continuity-token-secret>"
# 実験室マーカー (lab_marker) 署名シークレット (人・課金系からの完全分離)
UGK_LAB_MARKER_SECRET="<placeholder-lab-marker-secret>"
# エッジ受け渡し MAC シークレット (edge_attested 信頼階級検証)
UGK_EDGE_SECRET="<placeholder-edge-handoff-secret>"
# ML 決定トークン (decision_token) 署名シークレット
UGK_DECISION_TOKEN_SECRET="<placeholder-decision-token-secret>"
# 封緘アドレス・仮来訪者チケット用 KMS 鍵 ID
UGK_SEALING_KMS_KEY_ID="projects/<project-id>/locations/asia-northeast1/keyRings/ugokilink/cryptoKeys/sealing-v1"

# --- ML / 生成モデル推論 & 学習 (D-31a/b/c/d) ---
# 生成モデル推論プロバイダ: muse-glimmer-30b | gemma-4
UGK_LLM_PROVIDER="muse-glimmer-30b"
UGK_LLM_INFERENCE_ENDPOINT="https://llm-inference.ugokilink.example/v1"
UGK_LLM_INFERENCE_API_KEY="<placeholder-llm-inference-api-key>"
# 挑戦者・LoRA 学習用 GPU 計算基盤 (本番推論枠と別枠 D-31c)
UGK_GPU_TRAIN_ENDPOINT="https://gpu-train.ugokilink.example/v1"
UGK_GPU_TRAIN_API_KEY="<placeholder-gpu-train-api-key>"
# Jev 比較・推論用 API キー (契約＆地域ゲート通過まで未使用 / 学習・蒸留への利用は決定 D-31b により永久禁止)
UGK_JEV_API_KEY=""

# --- 外部連携・配信・定期実行 ---
# クロール連盟 (crawl federation) 検証エンドポイント
UGK_CRAWL_FEDERATION_ENDPOINT="https://crawl-federation.ugokilink.example/v1"
# A3 表現用 別オリジン隔離サンドボックスドメイン (顧客サイトと別オリジン必須 §10.5)
UGK_A3_SANDBOX_ORIGIN="https://a3-sandbox.ugokilink.example"
# Google Search Console Bulk Export 参照先プロジェクト ID
UGK_GSC_EXPORT_PROJECT="<placeholder-gsc-export-gcp-project>"
# GA4 同期用認証情報の Secret Manager 参照名 (実認証情報は記載しない)
UGK_GA4_SYNC_CREDENTIALS_REF="secret://ugokilink/ga4-sync-credentials"
# スケジューラ / Cron 呼び出し認証用シークレット
CRON_SECRET="<placeholder-cron-secret>"

# --- Option B 本番配線用（既存 ClickHouse の別 DB `ugoki_link_v2` へ接続）---
# true にすると /api/v1/** が ClickHouseSurfaceRepository 経由で実 ClickHouse を参照
UGK_ENABLE_V2_PROD_WIRING="false"
# v2 専用 ClickHouse URL（未設定時は既存 CLICKHOUSE_URL を流用; 専用 8GiB 移行時はここだけ変更）
UGK_CLICKHOUSE_V2_URL=""
# v2 ClickHouse データベース名（既存 clickinsight と物理分離）
UGK_CLICKHOUSE_V2_DB="ugoki_link_v2"
# 初期登録サイト一覧 JSON（scripts/link/bootstrap-bihadashop.mjs で生成）
UGK_SITES_BOOTSTRAP_JSON="[]"
