{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugokimap.com/schemas/partner-hosts.schema.json",
  "title": "Partner Hosts Allowlist",
  "description": "Domains allowed for next/image remotePatterns and lib/url-allowlist server-side fetch. Internal addresses MUST NOT appear.",
  "type": "object",
  "required": ["hosts"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "_audit_log": { "type": "string" },
    "_security": { "type": "string" },
    "hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 253,
        "description": "Lower-case domain. `*.example.com` で subdomain ワイルドカード (1 階層のみ)。`**` 禁止、`localhost` / プライベート IP 禁止、metadata endpoint 禁止。",
        "allOf": [
          {
            "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
            "description": "Subdomain ワイルドカードは先頭の `*.` のみ許可、全 label は lowercase alnum + ハイフン、2 階層以上"
          },
          {
            "not": {
              "anyOf": [
                { "pattern": "^localhost$" },
                { "pattern": "^127\\." },
                { "pattern": "^10\\." },
                { "pattern": "^172\\.(1[6-9]|2[0-9]|3[01])\\." },
                { "pattern": "^192\\.168\\." },
                { "pattern": "^169\\.254\\." },
                { "pattern": "metadata" },
                { "pattern": "internal\\.$" },
                { "pattern": "\\.local$" },
                { "pattern": "\\.lan$" },
                { "pattern": "\\.localhost$" },
                { "pattern": "\\*\\*" }
              ]
            },
            "description": "Private IP / metadata endpoint / .local / .internal / `**` ワイルドカードを拒否"
          }
        ]
      }
    }
  }
}
